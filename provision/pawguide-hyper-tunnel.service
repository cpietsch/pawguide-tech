[Unit]
Description=PawGuide Hyper.ai simulator tunnel
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/ssh -i /root/.ssh/pawguide_gpu_server -p 31612 -N -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -o StrictHostKeyChecking=yes -L 127.0.0.1:17779:127.0.0.1:7779 -L 100.102.208.90:9991:127.0.0.1:9991 root@ssh.hyper.ai
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
