+def add_acceptance_obstacle(costmap: OccupancyGrid) -> OccupancyGrid:
+    """Rasterize the selected deterministic fixture into the simulation costmap."""
+    fixture = selected_fixture()
+    if fixture is None:
+        return costmap
+    result = OccupancyGrid(
+        grid=costmap.grid.copy(),
+        resolution=costmap.resolution,
+        origin=costmap.origin,
+        frame_id=costmap.frame_id,
+        ts=costmap.ts,
+    )
+    origin_x, origin_y = costmap.origin.position.x, costmap.origin.position.y
+
+    arena_min_x, arena_max_x, arena_min_y, arena_max_y = fixture.arena
+    arena_x0 = max(
+        0, math.floor((arena_min_x - origin_x) / costmap.resolution)
+    )
+    arena_x1 = min(
+        result.width,
+        math.ceil((arena_max_x - origin_x) / costmap.resolution) + 1,
+    )
+    arena_y0 = max(
+        0, math.floor((arena_min_y - origin_y) / costmap.resolution)
+    )
+    arena_y1 = min(
+        result.height,
+        math.ceil((arena_max_y - origin_y) / costmap.resolution) + 1,
+    )
+    if arena_x0 < arena_x1 and arena_y0 < arena_y1:
+        arena = result.grid[arena_y0:arena_y1, arena_x0:arena_x1]
+        # A selected fixture is authoritative inside its arena. Do not retain
+        # walls or transient occupancy from the source room; redraw only the
+        # arena border and the fixture's explicit obstacles below.
+        arena[:, :] = CostValues.FREE
+        arena[0, :] = CostValues.OCCUPIED
+        arena[-1, :] = CostValues.OCCUPIED
+        arena[:, 0] = CostValues.OCCUPIED
+        arena[:, -1] = CostValues.OCCUPIED
+
+    for obstacle in fixture.obstacles:
+        _rasterize_obstacle(result, obstacle)
+    return result
+
+
+def _rasterize_obstacle(result: OccupancyGrid, obstacle: BoxObstacle) -> None:
+    center_x, center_y, _ = obstacle.center
+    cosine, sine = math.cos(obstacle.yaw), math.sin(obstacle.yaw)
+    half_x, half_y, _ = obstacle.half_extents
+    origin_x, origin_y = result.origin.position.x, result.origin.position.y
+    world_half_x = abs(cosine) * half_x + abs(sine) * half_y
+    world_half_y = abs(sine) * half_x + abs(cosine) * half_y
+    column_start = max(
+        0, math.floor((center_x - world_half_x - origin_x) / result.resolution)
+    )
+    column_stop = min(
+        result.width,
+        math.ceil((center_x + world_half_x - origin_x) / result.resolution) + 1,
+    )
+    row_start = max(
+        0, math.floor((center_y - world_half_y - origin_y) / result.resolution)
+    )
+    row_stop = min(
+        result.height,
+        math.ceil((center_y + world_half_y - origin_y) / result.resolution) + 1,
+    )
+    if column_start >= column_stop or row_start >= row_stop:
+        return
+
+    rows, columns = np.indices(
+        (row_stop - row_start, column_stop - column_start)
+    )
+    rows += row_start
+    columns += column_start
+    world_x = origin_x + (columns + 0.5) * result.resolution
+    world_y = origin_y + (rows + 0.5) * result.resolution
+    dx, dy = world_x - center_x, world_y - center_y
+    local_x = cosine * dx + sine * dy
+    local_y = -sine * dx + cosine * dy
+    wall = (np.abs(local_x) <= half_x) & (np.abs(local_y) <= half_y)
+    region = result.grid[row_start:row_stop, column_start:column_stop]
+    region[wall] = CostValues.OCCUPIED
+
+
+def path_is_collision_free(path: Path, costmap: OccupancyGrid) -> bool:
+    """Check every grid cell crossed by a path, including between poses."""
+    if not path.poses or costmap.grid.size == 0:
+        return False
+
+    height, width = costmap.grid.shape
+    sample_spacing = max(costmap.resolution / 2, 0.001)
+
+    for start, end in zip(path.poses, path.poses[1:], strict=False):
+        dx = end.position.x - start.position.x
+        dy = end.position.y - start.position.y
+        samples = max(1, math.ceil(math.hypot(dx, dy) / sample_spacing))
+
+        for index in range(samples + 1):
+            fraction = index / samples
+            point = Vector3(
+                start.position.x + dx * fraction,
+                start.position.y + dy * fraction,
+                0.0,
+            )
+            cell = costmap.world_to_grid(point)
+            x, y = int(math.floor(cell.x)), int(math.floor(cell.y))
+            if x < 0 or x >= width or y < 0 or y >= height:
+                return False
+            value = int(costmap.grid[y, x])
+            if value == CostValues.UNKNOWN or value >= CostValues.OCCUPIED:
+                return False
+
+    return True
+

