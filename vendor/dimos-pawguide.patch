+import math
+
+import pytest
+
+from dimos.simulation.mujoco.pawguide_fixtures import (
+    CONCEPT_GATE,
+    CONCEPT_GATE_BLOCKED,
+    ENGINEERING_SHORT,
+    apply_initial_base_position,
+    selected_fixture,
+    selected_home_position,
+)
+
+
+def _distance_to_box(point: tuple[float, float]) -> float:
+    obstacle = CONCEPT_GATE_BLOCKED.obstacles[0]
+    dx = point[0] - obstacle.center[0]
+    dy = point[1] - obstacle.center[1]
+    cosine, sine = math.cos(obstacle.yaw), math.sin(obstacle.yaw)
+    local_x = cosine * dx + sine * dy
+    local_y = -sine * dx + cosine * dy
+    dx = abs(local_x) - obstacle.half_extents[0]
+    dy = abs(local_y) - obstacle.half_extents[1]
+    return math.hypot(max(dx, 0.0), max(dy, 0.0))
+
+
+def test_concept_waypoints_are_exactly_five_metres_apart() -> None:
+    home = CONCEPT_GATE.waypoints["home"]
+    gate = CONCEPT_GATE.waypoints["demo_gate"]
+    assert math.dist(home[:2], gate[:2]) == pytest.approx(5.0)
+
+
+def test_concept_lane_is_clear_and_direct() -> None:
+    assert CONCEPT_GATE.obstacles == ()
+    assert CONCEPT_GATE.blocked_lane == ()
+    assert CONCEPT_GATE.protected_lane == (
+        (0.0, -2.5),
+        (3.6, 0.9698703145794942),
+    )
+    assert CONCEPT_GATE.arena == (-0.4, 4.0, -2.9, 1.3698703145794942)
+
+
+def test_blocked_concept_spans_lane_with_no_bypass() -> None:
+    assert CONCEPT_GATE_BLOCKED.blocked_lane == CONCEPT_GATE.protected_lane
+    assert CONCEPT_GATE_BLOCKED.protected_lane == CONCEPT_GATE.protected_lane
+    assert _distance_to_box((1.8, -0.7650648427102529)) == 0.0
+    obstacle = CONCEPT_GATE_BLOCKED.obstacles[0]
+    route_angle = math.atan2(
+        CONCEPT_GATE.waypoints["demo_gate"][1] - CONCEPT_GATE.waypoints["home"][1],
+        CONCEPT_GATE.waypoints["demo_gate"][0] - CONCEPT_GATE.waypoints["home"][0],
+    )
+    assert abs(math.cos(obstacle.yaw - route_angle)) == pytest.approx(0.0)
+    assert obstacle.half_extents[0] == pytest.approx(3.10)
+
+
+def test_explicit_fixture_selection_and_legacy_fallback(monkeypatch) -> None:
+    monkeypatch.setenv("DIMOS_MUJOCO_FIXTURE", "concept_gate")
+    assert selected_fixture() is CONCEPT_GATE
+    monkeypatch.delenv("DIMOS_MUJOCO_FIXTURE")
+    monkeypatch.setenv("DIMOS_MUJOCO_ACCEPTANCE_OBSTACLE", "1")
+    assert selected_fixture() is ENGINEERING_SHORT
+
+
+def test_blocked_fixture_is_separately_selectable(monkeypatch) -> None:
+    monkeypatch.setenv("DIMOS_MUJOCO_FIXTURE", "concept_gate_blocked")
+    assert selected_fixture() is CONCEPT_GATE_BLOCKED
+
+
+@pytest.mark.parametrize(
+    ("fixture_name", "expected"),
+    [
+        ("engineering_short", (-0.9993774, 0.999136, 0.295)),
+        ("concept_gate", (0.0, -2.5, 0.295)),
+        ("concept_gate_blocked", (0.0, -2.5, 0.295)),
+    ],
+)
+def test_selected_fixture_supplies_exact_initial_home(
+    monkeypatch, fixture_name: str, expected: tuple[float, float, float]
+) -> None:
+    monkeypatch.setenv("DIMOS_MUJOCO_FIXTURE", fixture_name)
+    assert selected_home_position() == expected
+
+
+@pytest.mark.parametrize(
+    ("fixture_name", "expected"),
+    [
+        ("engineering_short", (-0.9993774, 0.999136, 0.295)),
+        ("concept_gate", (0.0, -2.5, 0.295)),
+        ("concept_gate_blocked", (0.0, -2.5, 0.295)),
+    ],
+)
+def test_final_process_assignment_overrides_cli_default_for_all_xyz(
+    monkeypatch, fixture_name: str, expected: tuple[float, float, float]
+) -> None:
+    monkeypatch.setenv("DIMOS_MUJOCO_FIXTURE", fixture_name)
+    qpos = [99.0, 99.0, 99.0, 1.0, 0.0, 0.0, 0.0]
+
+    applied = apply_initial_base_position(qpos, (-1.0, 1.0, 0.3))
+
+    assert applied == expected
+    assert tuple(qpos[0:3]) == expected
+
+
+def test_final_process_assignment_retains_cli_default_without_fixture(
+    monkeypatch,
+) -> None:
+    monkeypatch.delenv("DIMOS_MUJOCO_FIXTURE", raising=False)
+    monkeypatch.delenv("DIMOS_MUJOCO_ACCEPTANCE_OBSTACLE", raising=False)
+    qpos = [0.0] * 7
+
+    applied = apply_initial_base_position(qpos, (-1.0, 1.0, 0.3))
+
+    assert applied == (-1.0, 1.0, 0.3)
+    assert tuple(qpos[0:3]) == applied
+
+
+def test_unknown_fixture_fails_closed(monkeypatch) -> None:
+    monkeypatch.setenv("DIMOS_MUJOCO_FIXTURE", "typo")
+    with pytest.raises(ValueError, match="unknown DIMOS_MUJOCO_FIXTURE"):
+        selected_fixture()
