+def _acceptance_position_is_clear(x: float, y: float) -> bool:
+    fixture = selected_fixture()
+    if fixture is None:
+        return True
+    for obstacle in fixture.obstacles:
+        center_x, center_y, _ = obstacle.center
+        cosine, sine = math.cos(obstacle.yaw), math.sin(obstacle.yaw)
+        dx, dy = x - center_x, y - center_y
+        local_x = cosine * dx + sine * dy
+        local_y = -sine * dx + cosine * dy
+        half_x, half_y, _ = obstacle.half_extents
+        outside_x = max(abs(local_x) - half_x, 0.0)
+        outside_y = max(abs(local_y) - half_y, 0.0)
+        if math.hypot(outside_x, outside_y) <= 0.31:
+            return False
+    return True
+
+
+def _apply_kinematic_drive(
+    model: mujoco.MjModel,
+    data: mujoco.MjData,
+    command: NDArray[Any],
+    dt: float,
+) -> None:
+    """Apply a deterministic planar proxy drive for acceptance testing."""
+    w, x, y, z = data.qpos[3:7]
+    yaw = math.atan2(2 * (w * z + x * y), 1 - 2 * (y * y + z * z))
+    forward, left, angular = command
+    proposed_x = data.qpos[0] + (
+        math.cos(yaw) * forward - math.sin(yaw) * left
+    ) * dt
+    proposed_y = data.qpos[1] + (
+        math.sin(yaw) * forward + math.cos(yaw) * left
+    ) * dt
+    if _acceptance_position_is_clear(proposed_x, proposed_y):
+        data.qpos[0] = proposed_x
+        data.qpos[1] = proposed_y
+    yaw += angular * dt
+    data.qpos[3:7] = [math.cos(yaw / 2), 0, 0, math.sin(yaw / 2)]
+    data.qvel[0:2] = 0
+    data.qvel[5] = 0
+    mujoco.mj_forward(model, data)
+
+
