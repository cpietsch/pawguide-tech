+
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from dimos.agents.skills.pawguide_waypoint import (
+    PawGuideWaypointSkill,
+    WaypointStore,
+)
+from dimos.msgs.geometry_msgs.PoseStamped import PoseStamped
+
+
+class FakeNavigation:
+    def __init__(self, *, accept_goal: bool = True) -> None:
+        self.accept_goal = accept_goal
+        self.goals: list[PoseStamped] = []
+        self.cancelled = False
+
+    def set_goal(self, goal: PoseStamped) -> bool:
+        self.goals.append(goal)
+        return self.accept_goal
+
+    def cancel_goal(self) -> bool:
+        self.cancelled = True
+        return True
+
+
+def make_skill(path: Path, navigation: FakeNavigation) -> PawGuideWaypointSkill:
+    instance = object.__new__(PawGuideWaypointSkill)
+    instance.config = SimpleNamespace(  # type: ignore[assignment]
+        waypoint_path=path,
+        goal_frame_id="map",
+    )
+    instance._store = WaypointStore(path)
+    instance._skill_started = True
+    instance._latest_odom = PoseStamped(
+        position=[1.0, 2.0, 0.1],
+        orientation=[0.0, 0.0, 0.5, 0.8660254],
+        frame_id="odom",
+    )
+    instance._navigation = navigation
+    return instance
+
+
+def test_tag_and_navigate_exact_waypoint(tmp_path: Path) -> None:
+    navigation = FakeNavigation()
+    skill = make_skill(tmp_path / "waypoints.json", navigation)
+
+    assert "demo_a" in skill.tag_location("demo_a")
+    assert "demo_a" in skill.navigate_to_waypoint("demo_a")
+
+    assert len(navigation.goals) == 1
+    goal = navigation.goals[0]
+    assert goal.frame_id == "map"
+    assert goal.position.x == 1.0
+    assert goal.position.y == 2.0
+    assert goal.orientation.w == pytest.approx(0.8660254)
+    assert (tmp_path / "waypoints.json").stat().st_mode & 0o777 == 0o600
+
+
+@pytest.mark.parametrize(
+    "waypoint_id",
+    ["", "Demo", "../home", "with space", "x" * 65],
+)
+def test_rejects_unsafe_waypoint_ids(tmp_path: Path, waypoint_id: str) -> None:
+    skill = make_skill(tmp_path / "waypoints.json", FakeNavigation())
+
+    with pytest.raises(ValueError, match="waypoint_id"):
+        skill.tag_location(waypoint_id)
+
+
+def test_unknown_waypoint_fails_closed(tmp_path: Path) -> None:
+    skill = make_skill(tmp_path / "waypoints.json", FakeNavigation())
+
+    with pytest.raises(ValueError, match="unknown waypoint"):
+        skill.navigate_to_waypoint("missing")
+
+
+def test_corrupt_waypoint_file_fails_closed(tmp_path: Path) -> None:
+    path = tmp_path / "waypoints.json"
+    path.write_text('{"version": 1, "waypoints": {"home": {"position": []}}}')
+    skill = make_skill(path, FakeNavigation())
+
+    with pytest.raises(RuntimeError, match="invalid waypoint file"):
+        skill.navigate_to_waypoint("home")
+
+
+def test_rejected_goal_is_reported(tmp_path: Path) -> None:
+    skill = make_skill(tmp_path / "waypoints.json", FakeNavigation(accept_goal=False))
+    skill.tag_location("home")
+
+    with pytest.raises(RuntimeError, match="navigator rejected"):
+        skill.navigate_to_waypoint("home")
+
+
+def test_stop_navigation_cancels_goal(tmp_path: Path) -> None:
+    navigation = FakeNavigation()
+    skill = make_skill(tmp_path / "waypoints.json", navigation)
+
