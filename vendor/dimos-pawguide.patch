+
+@pytest.mark.parametrize(("yaw_error", "expected"), [(0.1, 1.5), (-0.1, -1.5)])
+def test_kinematic_simulation_uses_fast_rotation_floor(
+    monkeypatch, yaw_error: float, expected: float
+) -> None:
+    monkeypatch.setenv("DIMOS_MUJOCO_KINEMATIC_DRIVE", "1")
+    controller = PController(
