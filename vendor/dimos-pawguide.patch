@@ -0,0 +1,123 @@
+"""Deterministic PawGuide MuJoCo fixtures shared by rendering and planning."""
+
+from dataclasses import dataclass
+import os
+from typing import Any
+
+
+@dataclass(frozen=True)
+class BoxObstacle:
+    name: str
+    center: tuple[float, float, float]
+    yaw: float
+    half_extents: tuple[float, float, float]
+
+
+@dataclass(frozen=True)
+class Fixture:
+    name: str
+    waypoints: dict[str, tuple[float, float, float]]
+    obstacles: tuple[BoxObstacle, ...]
+    arena: tuple[float, float, float, float]
+    blocked_lane: tuple[tuple[float, float], ...]
+    protected_lane: tuple[tuple[float, float], ...]
+    blocked_lane_half_width: float
+    protected_lane_half_width: float
+
+
+ENGINEERING_SHORT = Fixture(
+    name="engineering_short",
+    waypoints={
+        "home": (-0.9993774, 0.999136, 0.295),
+        "demo_a": (0.095598, 1.478714, 0.295),
+    },
+    obstacles=(
+        BoxObstacle(
+            name="pawguide_detour_wall",
+            center=(-0.451889732, 1.238925028, 0.50),
+            yaw=0.412813891,
+            half_extents=(0.08, 0.35, 0.50),
+        ),
+    ),
+    arena=(-1.7, 0.5, 0.4, 2.4),
+    blocked_lane=((-0.9993774, 0.999136), (0.095598, 1.478714)),
+    protected_lane=(
+        (-0.9993774, 0.999136),
+        (-0.75, 1.65),
+        (-0.1, 1.85),
+        (0.095598, 1.478714),
+    ),
+    blocked_lane_half_width=0.20,
+    protected_lane_half_width=0.20,
+)
+
+CONCEPT_GATE = Fixture(
+    name="concept_gate",
+    waypoints={
+        "home": (0.0, -2.5, 0.295),
+        "demo_gate": (3.6, 0.9698703145794942, 0.295),
+    },
+    obstacles=(),
+    arena=(-0.4, 4.0, -2.9, 1.3698703145794942),
+    blocked_lane=(),
+    protected_lane=((0.0, -2.5), (3.6, 0.9698703145794942)),
+    blocked_lane_half_width=0.0,
+    protected_lane_half_width=0.30,
+)
+
+CONCEPT_GATE_BLOCKED = Fixture(
+    name="concept_gate_blocked",
+    waypoints=CONCEPT_GATE.waypoints,
+    obstacles=(
+        BoxObstacle(
+            name="pawguide_concept_gate_blocking_wall",
+            center=(1.8, -0.7650648427102529, 0.50),
+            yaw=2.3377903346567632,
+            half_extents=(3.10, 0.12, 0.50),
+        ),
+    ),
+    arena=CONCEPT_GATE.arena,
+    blocked_lane=((0.0, -2.5), (3.6, 0.9698703145794942)),
+    protected_lane=CONCEPT_GATE.protected_lane,
+    blocked_lane_half_width=0.30,
+    protected_lane_half_width=0.30,
+)
+
+FIXTURES = {
+    ENGINEERING_SHORT.name: ENGINEERING_SHORT,
+    CONCEPT_GATE.name: CONCEPT_GATE,
+    CONCEPT_GATE_BLOCKED.name: CONCEPT_GATE_BLOCKED,
+}
+
+
+def selected_fixture() -> Fixture | None:
+    """Resolve the explicit fixture, retaining the old short-fixture switch."""
+    name = os.getenv("DIMOS_MUJOCO_FIXTURE")
+    if name:
+        try:
+            return FIXTURES[name]
+        except KeyError as exc:
+            supported = ", ".join(sorted(FIXTURES))
+            raise ValueError(
+                f"unknown DIMOS_MUJOCO_FIXTURE {name!r}; choose {supported}"
+            ) from exc
+    if os.getenv("DIMOS_MUJOCO_ACCEPTANCE_OBSTACLE") == "1":
+        return ENGINEERING_SHORT
+    return None
+
+
+def selected_home_position() -> tuple[float, float, float] | None:
+    """Return the exact initial base position for the selected fixture."""
+    fixture = selected_fixture()
+    if fixture is None:
+        return None
+    return fixture.waypoints["home"]
+
+
+def apply_initial_base_position(
+    qpos: Any, default_position: tuple[float, float, float]
+) -> tuple[float, float, float]:
+    """Apply the selected fixture home at the final process initialization."""
+    position = selected_home_position() or default_position
+    qpos[0:3] = position
+    return position
