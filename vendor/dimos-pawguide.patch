+"""Small, exact-match waypoint store for the PawGuide edge MVP."""
+
+from __future__ import annotations
+
+import json
+import math
+import os
+from pathlib import Path
+import re
+import tempfile
+import threading
+from typing import Any, TypedDict
+
+from reactivex.disposable import Disposable
+
+from dimos.agents.annotation import skill
+from dimos.agents.capabilities import CAP_MOVEMENT
+from dimos.core.core import rpc
+from dimos.core.module import Module, ModuleConfig
+from dimos.core.stream import In
+from dimos.msgs.geometry_msgs.PoseStamped import PoseStamped
+from dimos.navigation.navigation_spec import NavigationInterfaceSpec
+
+_WAYPOINT_ID = re.compile(r"^[a-z0-9][a-z0-9_-]{0,63}$")
+
+
+class StoredPose(TypedDict):
+    position: list[float]
+    orientation: list[float]
+
+
+class WaypointDocument(TypedDict):
+    version: int
+    waypoints: dict[str, StoredPose]
+
+
+class WaypointStore:
+    """Persist exact waypoint poses without a database or embedding model."""
+
+    def __init__(self, path: Path) -> None:
+        self._path = path
+        self._lock = threading.Lock()
+
+    @staticmethod
+    def validate_id(waypoint_id: str) -> None:
+        if not _WAYPOINT_ID.fullmatch(waypoint_id):
+            raise ValueError(
+                "waypoint_id must contain only lowercase letters, digits, "
+                "underscores or hyphens and be at most 64 characters"
+            )
+
+    @staticmethod
+    def _validate_vector(value: object, length: int, field: str) -> list[float]:
+        if not isinstance(value, list) or len(value) != length:
+            raise ValueError(f"invalid waypoint {field}")
+        result: list[float] = []
+        for item in value:
+            if isinstance(item, bool) or not isinstance(item, int | float):
+                raise ValueError(f"invalid waypoint {field}")
+            number = float(item)
+            if not math.isfinite(number):
+                raise ValueError(f"invalid waypoint {field}")
+            result.append(number)
+        return result
+
+    @classmethod
+    def _validate_document(cls, value: object) -> WaypointDocument:
+        if not isinstance(value, dict) or value.get("version") != 1:
+            raise ValueError("unsupported waypoint file")
+        raw_waypoints = value.get("waypoints")
+        if not isinstance(raw_waypoints, dict):
+            raise ValueError("invalid waypoint file")
+
+        waypoints: dict[str, StoredPose] = {}
+        for waypoint_id, raw_pose in raw_waypoints.items():
+            if not isinstance(waypoint_id, str):
+                raise ValueError("invalid waypoint ID")
+            cls.validate_id(waypoint_id)
+            if not isinstance(raw_pose, dict):
+                raise ValueError(f"invalid waypoint {waypoint_id}")
+            position = cls._validate_vector(raw_pose.get("position"), 3, "position")
+            orientation = cls._validate_vector(raw_pose.get("orientation"), 4, "orientation")
+            if math.sqrt(sum(component**2 for component in orientation)) < 1e-6:
+                raise ValueError("invalid waypoint orientation")
+            waypoints[waypoint_id] = {
+                "position": position,
+                "orientation": orientation,
+            }
+        return {"version": 1, "waypoints": waypoints}
+
+    def _load_unlocked(self) -> WaypointDocument:
+        if not self._path.exists():
+            return {"version": 1, "waypoints": {}}
+        try:
+            raw = json.loads(self._path.read_text(encoding="utf-8"))
+        except (OSError, json.JSONDecodeError) as exc:
+            raise RuntimeError(f"cannot read waypoint file {self._path}") from exc
+        try:
+            return self._validate_document(raw)
+        except ValueError as exc:
+            raise RuntimeError(f"invalid waypoint file {self._path}") from exc
+
+    def put(self, waypoint_id: str, pose: PoseStamped) -> None:
+        self.validate_id(waypoint_id)
+        stored_pose: StoredPose = {
+            "position": [pose.position.x, pose.position.y, pose.position.z],
+            "orientation": [
+                pose.orientation.x,
+                pose.orientation.y,
+                pose.orientation.z,
+                pose.orientation.w,
+            ],
+        }
+        with self._lock:
+            document = self._load_unlocked()
+            document["waypoints"][waypoint_id] = stored_pose
+            self._path.parent.mkdir(parents=True, exist_ok=True)
+            temporary_path: Path | None = None
+            try:
+                with tempfile.NamedTemporaryFile(
+                    mode="w",
+                    encoding="utf-8",
+                    dir=self._path.parent,
+                    prefix=f".{self._path.name}.",
+                    delete=False,
+                ) as temporary:
+                    temporary_path = Path(temporary.name)
+                    json.dump(document, temporary, indent=2, sort_keys=True)
+                    temporary.write("\n")
+                    temporary.flush()
+                    os.fsync(temporary.fileno())
+                temporary_path.chmod(0o600)
+                os.replace(temporary_path, self._path)
+            finally:
+                if temporary_path is not None:
+                    temporary_path.unlink(missing_ok=True)
+
+    def get(self, waypoint_id: str) -> StoredPose:
+        self.validate_id(waypoint_id)
+        with self._lock:
+            waypoint = self._load_unlocked()["waypoints"].get(waypoint_id)
+        if waypoint is None:
+            raise ValueError(f"unknown waypoint '{waypoint_id}'")
+        return waypoint
+
+
+class PawGuideWaypointConfig(ModuleConfig):
+    waypoint_path: Path = Path("/var/lib/pawguide/waypoints.json")
+    goal_frame_id: str = "map"
+
+
+class PawGuideWaypointSkill(Module):
+    """Exact named-waypoint navigation without visual-semantic memory."""
+
+    config: PawGuideWaypointConfig
+    odom: In[PoseStamped]
+    _navigation: NavigationInterfaceSpec
+    _latest_odom: PoseStamped | None = None
+    _skill_started: bool = False
+
+    def __init__(self, **kwargs: Any) -> None:
+        super().__init__(**kwargs)
+        self._store = WaypointStore(self.config.waypoint_path)
+
+    @rpc
+    def start(self) -> None:
+        super().start()
+        self.register_disposable(Disposable(self.odom.subscribe(self._on_odom)))
+        self._skill_started = True
+
+    @rpc
+    def stop(self) -> None:
+        self._skill_started = False
+        super().stop()
+
+    def _on_odom(self, odom: PoseStamped) -> None:
+        self._latest_odom = odom
+
+    @skill
+    def tag_location(self, waypoint_id: str) -> str:
+        """Save the robot's current pose under one exact waypoint ID.
+
+        This setup-only tool must be invoked directly by an operator, not by
+        the language model.
+
+        Args:
+            waypoint_id: Exact lowercase waypoint ID from the PawGuide allowlist.
+        """
+
+        if not self._skill_started:
+            raise RuntimeError("waypoint skill has not started")
+        if self._latest_odom is None:
+            raise RuntimeError("no odometry received")
+        self._store.put(waypoint_id, self._latest_odom)
+        return f"Tagged exact waypoint '{waypoint_id}'."
+
+    @skill(uses=[CAP_MOVEMENT])
+    def navigate_to_waypoint(self, waypoint_id: str) -> str:
+        """Navigate to one previously saved exact waypoint.
+
+        Args:
+            waypoint_id: Exact lowercase waypoint ID from the PawGuide allowlist.
+        """
+
+        if not self._skill_started:
+            raise RuntimeError("waypoint skill has not started")
+        stored = self._store.get(waypoint_id)
+        goal = PoseStamped(
+            position=stored["position"],
+            orientation=stored["orientation"],
+            frame_id=self.config.goal_frame_id,
+        )
+        if not self._navigation.set_goal(goal):
+            raise RuntimeError(f"navigator rejected waypoint '{waypoint_id}'")
+        return f"Started navigating to exact waypoint '{waypoint_id}'."
+
+    @skill
+    def stop_navigation(self) -> str:
+        """Cancel the active waypoint navigation immediately."""
+
+        if not self._skill_started:
+            raise RuntimeError("waypoint skill has not started")
+        self._navigation.cancel_goal()
+        return "Stopped waypoint navigation."
