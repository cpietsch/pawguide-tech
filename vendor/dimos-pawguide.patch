+++ b/dimos/navigation/replanning_a_star/global_planner.py
@@ -15,0 +16 @@
+import os
@@ -44,0 +46,86 @@
+_ACCEPTANCE_OBSTACLE_CENTER = (-0.451889732, 1.238925028)
+_ACCEPTANCE_OBSTACLE_YAW = 0.412813891
+_ACCEPTANCE_OBSTACLE_HALF_EXTENTS = (0.08, 0.35)
+
+
+def add_acceptance_obstacle(costmap: OccupancyGrid) -> OccupancyGrid:
+    """Rasterize the deterministic MuJoCo wall into the simulation costmap."""
+    result = OccupancyGrid(
+        grid=costmap.grid.copy(),
+        resolution=costmap.resolution,
+        origin=costmap.origin,
+        frame_id=costmap.frame_id,
+        ts=costmap.ts,
+    )
+    center_x, center_y = _ACCEPTANCE_OBSTACLE_CENTER
+    cosine, sine = math.cos(_ACCEPTANCE_OBSTACLE_YAW), math.sin(
+        _ACCEPTANCE_OBSTACLE_YAW
+    )
+    half_x, half_y = _ACCEPTANCE_OBSTACLE_HALF_EXTENTS
+    origin_x, origin_y = costmap.origin.position.x, costmap.origin.position.y
+
+    world_half_x = abs(cosine) * half_x + abs(sine) * half_y
+    world_half_y = abs(sine) * half_x + abs(cosine) * half_y
+    column_start = max(
+        0, math.floor((center_x - world_half_x - origin_x) / costmap.resolution)
+    )
+    column_stop = min(
+        result.width,
+        math.ceil((center_x + world_half_x - origin_x) / costmap.resolution) + 1,
+    )
+    row_start = max(
+        0, math.floor((center_y - world_half_y - origin_y) / costmap.resolution)
+    )
+    row_stop = min(
+        result.height,
+        math.ceil((center_y + world_half_y - origin_y) / costmap.resolution) + 1,
+    )
+    if column_start >= column_stop or row_start >= row_stop:
+        return result
+
+    rows, columns = np.indices(
+        (row_stop - row_start, column_stop - column_start)
+    )
+    rows += row_start
+    columns += column_start
+    world_x = origin_x + (columns + 0.5) * costmap.resolution
+    world_y = origin_y + (rows + 0.5) * costmap.resolution
+    dx, dy = world_x - center_x, world_y - center_y
+    local_x = cosine * dx + sine * dy
+    local_y = -sine * dx + cosine * dy
+    wall = (np.abs(local_x) <= half_x) & (np.abs(local_y) <= half_y)
+    region = result.grid[row_start:row_stop, column_start:column_stop]
+    region[wall] = CostValues.OCCUPIED
+    return result
+
+
+def path_is_collision_free(path: Path, costmap: OccupancyGrid) -> bool:
+    """Check every grid cell crossed by a path, including between poses."""
+    if not path.poses or costmap.grid.size == 0:
+        return False
+
+    height, width = costmap.grid.shape
+    sample_spacing = max(costmap.resolution / 2, 0.001)
+
+    for start, end in zip(path.poses, path.poses[1:], strict=False):
+        dx = end.position.x - start.position.x
+        dy = end.position.y - start.position.y
+        samples = max(1, math.ceil(math.hypot(dx, dy) / sample_spacing))
+
+        for index in range(samples + 1):
+            fraction = index / samples
+            point = Vector3(
+                start.position.x + dx * fraction,
+                start.position.y + dy * fraction,
+                0.0,
+            )
+            cell = costmap.world_to_grid(point)
+            x, y = int(math.floor(cell.x)), int(math.floor(cell.y))
+            if x < 0 or x >= width or y < 0 or y >= height:
+                return False
+            value = int(costmap.grid[y, x])
+            if value == CostValues.UNKNOWN or value >= CostValues.OCCUPIED:
+                return False
+
+    return True
+
