diff --git a/dimos/web/websocket_vis/test_websocket_vis_pose.py b/dimos/web/websocket_vis/test_websocket_vis_pose.py
new file mode 100644
index 0000000..22f4e28
--- /dev/null
+++ b/dimos/web/websocket_vis/test_websocket_vis_pose.py
@@ -0,0 +1,30 @@
+from typing import Any
+
+from dimos.msgs.geometry_msgs.PoseStamped import PoseStamped
+from dimos.web.websocket_vis.websocket_vis_module import WebsocketVisModule
+
+
+def test_robot_pose_event_and_full_state_retain_orientation() -> None:
+    vis = object.__new__(WebsocketVisModule)
+    vis.vis_state = {}
+    emitted: list[tuple[str, dict[str, Any]]] = []
+    vis._emit = lambda event, payload: emitted.append((event, payload))  # type: ignore[method-assign]
+    pose = PoseStamped(
+        position=(1.0, 2.0, 0.3),
+        orientation=(0.1, 0.2, 0.3, 0.9),
+        frame_id="world",
+    )
+
+    vis._on_robot_pose(pose)
+
+    expected = {
+        "type": "vector",
+        "c": [1.0, 2.0, 0.3],
+        "q": [0.1, 0.2, 0.3, 0.9],
+    }
+    assert emitted == [("robot_pose", expected)]
+
+    # The connect handler emits a shallow copy of vis_state as full_state.
+    full_state = dict(vis.vis_state)
+    assert full_state["robot_pose"] == expected
+    assert full_state["robot_pose"]["q"] == [0.1, 0.2, 0.3, 0.9]
