# Copy to /etc/pawguide/pawguide.env and chmod 0640 root:pawguide.
# Store the actual values in the referenced files, not here.
# Separate credentials preserve the local operator's authority. The Hetzner
# client cannot generate heartbeats or release a latched stop.
PAWGUIDE_OPERATOR_TOKEN_FILE=/etc/pawguide/operator.token
PAWGUIDE_DEV_TOKEN_FILE=/etc/pawguide/dev.token
PAWGUIDE_WAYPOINTS=home,demo_a,demo_b
# Set this to the device's Tailscale IPv4 address for a remote-only mock
# gateway. On the edge computer, use 0.0.0.0 so local USB/Ethernet links work.
PAWGUIDE_BIND_HOST=replace-with-bind-address
PAWGUIDE_PORT=8765

# The bundle always installs in mock mode. Real motion requires changing both
# values deliberately after the physical acceptance gate.
PAWGUIDE_ADAPTER=mock
PAWGUIDE_ENABLE_REAL_MOTION=NO
PAWGUIDE_DIMOS_MCP_URL=http://127.0.0.1:9990/mcp
# Keep the physical edge default fail-fast. The remote Hyper simulation relay
# may set 15 because STOP fans out across several MCP cleanup tools.
PAWGUIDE_DIMOS_MCP_TIMEOUT_S=5

# The current Unitree WebRTC driver resolves LocalAP to 192.168.12.1.
PAWGUIDE_ROBOT_CONNECTION=local_ap
# install-robot-credential.sh creates the separate root-owned file consumed
# through systemd LoadCredential; never place the value in this environment.
